# ============================================================
# WebYBook User Backend - Environment variables
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.
# ============================================================

# ---------- Database ----------
DB_URL=jdbc:mysql://localhost:3306/webybook?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# ---------- JWT ----------
# Must be at least 32 bytes (256 bits). Generate with:
#   openssl rand -base64 48
JWT_SECRET=replace-this-with-a-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=webybook

# ---------- Password reset ----------
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_URL=http://localhost:5173/reset-password

# ---------- Mail ----------
# false = do not send SMTP mail; print the reset link to the application log.
# true  = send real email using the SMTP settings below.
MAIL_ENABLED=false
MAIL_FROM=no-reply@webybook.vn
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_AUTH=true
SMTP_STARTTLS=true

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ---------- Server ----------
SERVER_PORT=8080
APP_LOG_LEVEL=INFO
SECURITY_LOG_LEVEL=INFO

# ---------- VNPay ----------
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payments/vnpay-return
